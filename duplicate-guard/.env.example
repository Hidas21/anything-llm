# ─── AnythingLLM connection (only thing to update when AnythingLLM changes) ───
ANYTHINGLLM_BASE_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=your-api-key-here

# Version-locked upload path — update only when AnythingLLM changes its API
ANYTHINGLLM_UPLOAD_PATH=/api/v1/document/upload

# ─── Guard service ────────────────────────────────────────────────────────────
GUARD_PORT=3002
DB_PATH=./hashes.db

# FAIL_OPEN=true  → if guard crashes, uploads go directly to AnythingLLM
# FAIL_OPEN=false → if guard crashes, uploads are blocked
FAIL_OPEN=true
